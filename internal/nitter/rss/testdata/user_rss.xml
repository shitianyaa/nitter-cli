<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixture shaped after the documented Nitter RSS format and the reference
  plugin's parser semantics (the plan's curl comparison against a real
  instance cannot run in the offline sandbox; it is carried as a user-run
  smoke step in Task 13). Four items:

  1. photo tweet: media:content (pbs.twimg.com, name=small) plus a
     percent-encoded relative /pic/media img inside the description;
  2. text-only tweet: no media at all;
  3. video tweet: relative /pic/<x>_video_thumb img, no media:content;
  4. GUID-less tweet: projection must fall back to <link>.
-->
<rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>NASA</title>
    <link>https://nitter.example/NASA/media</link>
    <description>Fixture feed mimicking a Nitter user timeline.</description>

